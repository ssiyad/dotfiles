output "LG Electronics LG ULTRAWIDE 608PMYH069538" {
    mode preferred
    scale 1
    adaptive_sync on
    transform normal
    alias $HOME_UW
}

output "Samsung Display Corp. 0x419D Unknown" {
    mode preferred
    scale 1.5
    adaptive_sync on
    transform normal
    alias $LAPTOP
}

profile {
    output $LAPTOP position 0,0 
}

profile {
    output $HOME_UW position 0,0 
    output $LAPTOP position 745,1440 
}
