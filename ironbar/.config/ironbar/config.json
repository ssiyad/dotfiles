{
    "name": "main",
    "icon_theme": "ironbar",
    "position": "top",
    "anchor_to_edges": true,
    "layer": "top",
    "exclusive_zone": false,
    "start_hidden": true,
    "height": 40,
    "popup_gap": 6,
    "start": [
        {
            "type": "workspaces",
            "format": "",
            "sort": "index"
        }
    ],
    "end": [
        {
            "type": "tray",
            "icon_size": 16
        },
        {
            "type": "volume",
            "format": "{icon}  {percentage}%",
            "mute_format": "{icon}  {percentage}%",
            "show_sources": false,
            "icons": {
                "volume": "󰕾",
                "muted": "󰖁"
            }
        },
        {
            "type": "battery",
            "format": "{percentage}%",
            "icon_size": 16,
            "profiles": {
                "critical": {
                    "percent": 15,
                    "charging": false
                },
                "warning": {
                    "percent": 30,
                    "charging": false
                }
            }
        },
        {
            "type": "custom",
            "name": "network",
            "bar": [
                {
                    "type": "image",
                    "src": "icon:{{5000:~/.config/ironbar/network.sh icon}}",
                    "size": 16
                },
                {
                    "type": "label",
                    "label": "{{5000:~/.config/ironbar/network.sh}}"
                }
            ]
        },
        {
            "type": "clock",
            "format": "%a %-d %b  %H:%M"
        }
    ],
    "margin": {
        "top": 6,
        "left": 8,
        "right": 8
    }
}
