include=~/.config/mako/acid/acid-acetic.conf

default-timeout=10000
icons=0
layer=overlay
max-visible=7

# Match the Ironbar pills: solid black, a thin grey border, rounded corners,
# and the same edge gaps as the bar.
font=Geist 10
border-size=1
border-color=#383838
border-radius=12
padding=10,12
margin=6

# Sit below the bar: its pills end at 44px (6px top margin + 40px height, less
# their 2px inner margin), and the 6px notification margin gives the same gap
# as the bar's popups.
outer-margin=44,2,0

# Ironbar has no accent colour, so urgency shows through text and border only.
[urgency=low]
text-color=#a49f95
border-color=#383838

[urgency=normal]
border-color=#383838

# Critical notifications stay until dismissed.
[urgency=high]
border-color=#ff4536
default-timeout=0

[hidden]
text-color=#5a5a5a
border-color=#383838
