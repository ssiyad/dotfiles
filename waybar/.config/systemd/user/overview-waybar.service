[Unit]
Description=Toggle waybar when the niri overview is opened or closed
PartOf=waybar.service
After=waybar.service
Requisite=waybar.service

[Service]
ExecStartPre=/usr/bin/sleep 2
ExecStart=/bin/bash %h/.config/waybar/overview-waybar
Restart=on-failure
RestartSec=1

[Install]
WantedBy=waybar.service
